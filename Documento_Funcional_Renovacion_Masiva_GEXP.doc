<!-- 4. ESPECIFICACIÓN TÉCNICA Y DATOS PARA TI  -->
<!-- ========================================== -->
<h1>4. Especificación Técnica & Modelo de Datos para Desarrollo TI</h1>

<h2>4.1 Diccionario de Datos: Entidad PolicyRenewal</h2>
<table>
  <thead>
    <tr>
      <th>Atributo</th>
      <th>Tipo de Dato</th>
      <th>Requerido</th>
      <th>Descripción y Reglas de Validación</th>
    </tr>
  </thead>
  <tbody>
    <tr><td><code>id</code></td><td>UUID / String</td><td>Sí</td><td>Clave primaria interna.</td></tr>
    <tr><td><code>numeroPoliza</code></td><td>Varchar(30)</td><td>Sí</td><td>Clave única de póliza en Core ACSEL.</td></tr>
    <tr><td><code>productoCodigo</code></td><td>Varchar(10)</td><td>Sí</td><td>Identificador del producto (ej. 'GEXP').</td></tr>
    <tr><td><code>contratante</code></td><td>Varchar(150)</td><td>Sí</td><td>Nombre del asegurado titular o empresa.</td></tr>
    <tr><td><code>tipoDocumentoContratante</code></td><td>Enum</td><td>Sí</td><td>'Cédula' | 'RNC' | 'Pasaporte'.</td></tr>
    <tr><td><code>documentoContratante</code></td><td>Varchar(25)</td><td>Sí</td><td>Documento de identidad validado.</td></tr>
    <tr><td><code>correoCliente</code></td><td>Varchar(100)</td><td>Sí</td><td>Email del cliente. Valida sintaxis RFC 5322.</td></tr>
    <tr><td><code>corredor</code></td><td>Varchar(120)</td><td>Sí</td><td>Nombre del intermediario asignado.</td></tr>
    <tr><td><code>correoCorredor</code></td><td>Varchar(100)</td><td>No</td><td>Buzón del corredor para copia CC.</td></tr>
    <tr><td><code>supervisorNegocio</code></td><td>Varchar(120)</td><td>No</td><td>Supervisor corporativo de Seguros Universal.</td></tr>
    <tr><td><code>correoSupervisor</code></td><td>Varchar(100)</td><td>No</td><td>Buzón corporativo para copia CC.</td></tr>
    <tr><td><code>cantidadAsegurados</code></td><td>Integer</td><td>Sí</td><td>Cantidad de dependientes/asegurados cubiertos.</td></tr>
    <tr><td><code>fechaRenovacion</code></td><td>Date (ISO)</td><td>Sí</td><td>Fecha de efecto de la renovación.</td></tr>
    <tr><td><code>tarifaActualAnual</code></td><td>Decimal(14,2)</td><td>Sí</td><td>Prima anual vigente en Core ACSEL.</td></tr>
    <tr><td><code>tarifaRenovacionAnual</code></td><td>Decimal(14,2)</td><td>Sí</td><td>Prima anual renovada calculada.</td></tr>
    <tr><td><code>tipoRenovacion</code></td><td>Enum</td><td>Sí</td><td><strong>'CAMBIO_PLAN' | 'AJUSTE_TASA'</strong>.</td></tr>
    <tr><td><code>aplicaPorcentajeAjuste</code></td><td>Boolean</td><td>Sí</td><td><strong>false</strong> si es CAMBIO_PLAN; <strong>true</strong> si es AJUSTE_TASA.</td></tr>
    <tr><td><code>porcentajeIncremento</code></td><td>Decimal(5,2)</td><td>Sí</td><td>Porcentaje aplicado (0.00% si aplicaPorcentajeAjuste === false).</td></tr>
    <tr><td><code>planRenovacion</code></td><td>Varchar(100)</td><td>Sí</td><td>Plan resultante al cual renovará la póliza.</td></tr>
    <tr><td><code>saldoPendiente</code></td><td>Decimal(14,2)</td><td>No</td><td>Deuda impaga en ACSEL (dispara REG-05 si &gt; 0).</td></tr>
    <tr><td><code>enListaNegra</code></td><td>Boolean</td><td>No</td><td>Coincidencia en listas restrictivas (dispara REG-04).</td></tr>
    <tr><td><code>estado</code></td><td>Enum</td><td>Sí</td><td>'Pendiente' | 'Validado' | 'Error' | 'Renovado y Notificado'.</td></tr>
  </tbody>
</table>

